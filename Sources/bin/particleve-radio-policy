#!/usr/bin/python3 -I
import sys

sys.path.insert(0, "/usr/lib/particleve")
from particleve.common import Error
from particleve.radio import serve

try:
    serve()
except (Error, OSError, ValueError, TypeError, KeyError) as exc:
    print(f"particleve-radio-policy: {exc}", file=sys.stderr)
    raise SystemExit(1)
