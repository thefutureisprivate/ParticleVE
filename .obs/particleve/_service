<services>
  <service name="obs_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/thefutureisprivate/particleve.git</param>
    <param name="revision">build</param>
    <param name="filename">particleve</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="match-tag">v[0-9]*.[0-9]*.[0-9]*.[0-9]*</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
    <param name="extract">.obs/fedora/x86-64/mkosi.conf</param>
    <param name="extract">.obs/particleve/allocator.spec</param>
    <param name="extract">.obs/particleve/hardened_malloc-chacha-output-pointer.patch</param>
    <param name="extract">.obs/particleve/hardened_malloc.allowed_signers</param>
    <param name="extract">sources.lock.json</param>
    <param name="extract">Sources/particleve/package_sources.py</param>
    <param name="extract">Tests/acceptance/allocator/chacha-boundaries.c</param>
    <param name="extract-rename">.obs/particleve/allocator.spec:hardened_malloc.recipe</param>
  </service>
  <service name="download_files" />
  <service name="tar" mode="buildtime" />
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">xz</param>
  </service>
</services>
