#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

# Upstream enables the optional userdb link before profile hooks run. The
# ParticleVE factory SSH defaults already supply AuthorizedKeysCommand; remove
# the link rule before tmpfiles can follow the read-only factory directory.
rm -f /usr/lib/tmpfiles.d/20-systemd-userdb.conf

test -f /usr/lib/particleve/build.json
# The selected client has no DHCP, symmetric-key or environment-driven inputs.
rm -f /etc/dhcp/dhclient.d/chrony.sh /etc/chrony.keys /etc/sysconfig/chronyd
# Audit and SELinux remain enabled. Reproducible defaults are captured by upstream mkosi.finalize.
install -d /etc/selinux
cat >/etc/selinux/config <<'EOF'
SELINUX=enforcing
SELINUXTYPE=targeted
EOF
install -d /etc/systemd/zram-generator.conf.d
printf '# Deliberately empty: encrypted block swap backs zswap.\n' >/etc/systemd/zram-generator.conf
ln -s /dev/null /etc/systemd/zram-generator.conf.d/00-disable.conf
# No independent upstream transfer/installer/reset path may mutate the selected disk pair.
rm -rf /usr/lib/sysupdate.d /usr/lib/sysupdate.reboot.d /usr/lib/repart.d
install -d /usr/lib/sysupdate.d
ln -sf /dev/null /usr/lib/systemd/system/systemd-sysupdate.service
ln -sf /dev/null /usr/lib/systemd/system/systemd-sysupdate.timer
ln -sf /dev/null /usr/lib/systemd/system/systemd-sysupdate-reboot.service
ln -sf /dev/null /usr/lib/systemd/system/systemd-sysupdate-reboot.timer
ln -sf /dev/null /usr/lib/systemd/system/systemd-repart.service
systemctl preset-all
systemctl disable systemd-sysupdate-update.timer systemd-sysupdate-reboot.timer
# systemd-boot updates are exclusively installed by the two-disk coordinator.
ln -sf /dev/null /usr/lib/systemd/system/systemd-boot-update.service
# PAM is generated in the image; a boot-time authselect rewrite cannot update /usr.
ln -sf /dev/null /usr/lib/systemd/system/authselect-apply-changes.service
# Host code/configuration is delivered by the signed OS, never mutable extensions
# or portable host workloads. Guest definitions remain externally managed.
for unit in systemd-sysext.service systemd-sysext.socket systemd-confext.service systemd-confext.socket \
            systemd-portabled.service systemd-timesyncd.service chronyd.service chrony-wait.service \
            ksm.service ksmtuned.service systemd-rfkill.service systemd-rfkill.socket; do
    ln -sf /dev/null "/usr/lib/systemd/system/$unit"
done
# ParticleVE owns radio state. Retain the upstream device tag and unrelated
# activations, but remove the request for its masked save/restore socket.
sed -i 's/, ENV{SYSTEMD_WANTS}+="systemd-rfkill\.socket"//g' /usr/lib/udev/rules.d/99-systemd.rules
# Only configured links may obtain addresses; no generic DHCP fallback or trim job.
ln -sf /dev/null /usr/lib/systemd/network/89-ethernet.network
ln -sf /dev/null /usr/lib/systemd/system/fstrim.timer
# The factory directory is immutable. The public link needs the ordinary /etc
# link label; the target policy/configuration keeps its specific SELinux types.
printf '/etc/(selinux|audit) -l system_u:object_r:etc_t:s0\n' >>/etc/selinux/targeted/contexts/files/file_contexts.local
# Runtime views remain public certificate data. The NTS-state helper uses the
# already-selected restricted chrony domain, without a new transition.
printf '/run/particleve-ca-trust(/.*)? system_u:object_r:cert_t:s0\n/usr/libexec/particleve-nts-trust -- system_u:object_r:chronyd_exec_t:s0\n' >>/etc/selinux/targeted/contexts/files/file_contexts.local
# Resolved reads these root-owned, immutable-in-its-namespace policy views as
# ordinary systemd configuration, without access to generic runtime files.
printf '/run/particleve-dns-policy(/.*)? system_u:object_r:systemd_conf_t:s0\n' >>/etc/selinux/targeted/contexts/files/file_contexts.local
# Build the narrow EFI-write policy into the image, never the worker's kernel.
semodule --noreload --install /usr/lib/particleve/particleve_boot.cil
semodule --noreload --install /usr/lib/particleve/particleve_witness.pp
semodule --noreload --install /usr/lib/particleve/particleve_vmspawn.pp
semodule --noreload --install /usr/lib/particleve/particleve_runtime.cil
# Compile audit defaults before making the factory configuration read-only.
augenrules
# Capture the newly compiled policy and audit configuration in mkosi.finalize;
# packaged factory examples must not take precedence over the image's settings.
rm -rf /usr/share/factory/etc/selinux /usr/share/factory/etc/audit
# Keep the packaged SSH/PAM stack, adding only the required homed account gate.
# Root remains the independently accessible recovery/bootstrap account.
# NSS must include homed members when polkit expands the native wheel group.
# authselect's local profile supplies both providers but stops at files by default.
python3 - <<'PY'
from pathlib import Path

link = Path('/etc/nsswitch.conf')
path = Path('/etc/authselect/nsswitch.conf')
if not link.is_symlink() or link.readlink() != path or path.is_symlink():
    raise RuntimeError('unexpected authselect NSS authority')
lines = path.read_text().splitlines(keepends=True)
rows = [(index, line.split('#', 1)[0].split()) for index, line in enumerate(lines)]
groups = [(index, fields) for index, fields in rows if fields[:1] == ['group:']]
if len(groups) != 1 or groups[0][1] not in (
    ['group:', 'files', 'systemd'],
    ['group:', 'files', '[SUCCESS=merge]', 'systemd'],
):
    raise RuntimeError('unexpected authselect group lookup providers')
lines[groups[0][0]] = 'group: files [SUCCESS=merge] systemd\n'
path.write_text(''.join(lines))
PY
# Capture the selected authselect link instead of systemd's generic factory file.
rm -f /usr/share/factory/etc/nsswitch.conf
for stack in sshd system-auth password-auth; do
    test -f "/usr/lib/pam.d/$stack"
    sed -i '1i account requisite pam_exec.so quiet /usr/libexec/particleve-homed-account' "/usr/lib/pam.d/$stack"
done
# The configured /usr PAM stack is authoritative; the package's generic factory
# example must not shadow it when an installed writable root is initialized.
rm -rf /usr/share/factory/etc/pam.d
