[Unit]
Description=ParticleVE host management input filtering
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target sshd.socket shutdown.target
# Pull in metrics on existing installations as well as newly preset roots.
Wants=network-pre.target prometheus-node-exporter.service
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/bin/particleve apply-firewall
RemainAfterExit=yes
# The trusted rule loader only reads reviewed configuration and submits netlink
# transactions. It does not need IP sockets, device access, or filesystem writes.
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitCORE=0
UMask=0077

[Install]
WantedBy=multi-user.target
