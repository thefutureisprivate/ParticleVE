disable systemd-sysupdate*.timer
disable particleve-maintenance.timer
disable particleve-report.timer
disable systemd-sysext.*
disable systemd-confext.*
disable systemd-portabled.*
disable systemd-sysupdate-auto-enable.service
disable NetworkManager*
disable nftables.service
disable firewalld.service
disable dnf*.timer
disable fstrim.timer
disable packagekit*
disable cockpit*
disable libvirtd*
disable virtqemud*
enable particleve-firewall.service
enable particleve-radio-policy.service
enable particleve-boot-assess.service
enable systemd-machined.service
enable systemd-homed.service
enable systemd-homed-firstboot.service
enable systemd-userdbd.socket
enable particleve-runtime-ready.service
enable systemd-networkd.service
enable systemd-networkd-wait-online.service
enable systemd-resolved.service
disable systemd-timesyncd.service
disable chronyd.service
disable chrony-wait.service
enable chronyd-restricted.service
enable particleve-boot-watchdog.timer
enable fwupd-refresh.timer
enable sshd.socket
disable sshd.service

enable particleve-storage-watch.timer
